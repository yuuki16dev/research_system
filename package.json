{
  "name": "research_system",
  "version": "2.5.0",
  "description": "AI駆動型の自律リサーチ＆総合インテリジェンス自動生成システム",
  "main": "server/index.js",
  "bin": "server/index.js",
  "scripts": {
    "start": "node server/start.js",
    "stop": "node server/stop.js",
    "server": "node server/index.js",
    "dev": "node server/start.js",
    "test": "node --test",
    "test:exports": "node scripts/verify-all-exports.js",
    "test:exe": "node scripts/verify-exe.js",
    "fix:bat": "node scripts/normalize-bat.js",
    "build:exe": "npx --yes pkg . --targets node18-win-x64 --output dist/ResearchStudio.exe",
    "package:release": "node scripts/package-release.js",
    "build:all": "npm run build:exe && npm run package:release"
  },
  "pkg": {
    "scripts": [
      "server/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "server/templates/**/*",
      "node_modules/xlsx/dist/**/*",
      "node_modules/generator-function/**/*",
      "node_modules/async-function/**/*",
      "node_modules/is-generator-function/**/*",
      "node_modules/is-async-function/**/*",
      "node_modules/which-builtin-type/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "research",
    "intelligence",
    "gemini",
    "automation",
    "reporting"
  ],
  "author": "yuuki16dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuuki16dev/research_system.git"
  },
  "bugs": {
    "url": "https://github.com/yuuki16dev/research_system/issues"
  },
  "homepage": "https://github.com/yuuki16dev/research_system#readme",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
