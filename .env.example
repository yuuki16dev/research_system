# ==============================================================================
# Research Studio - 環境変数設定テンプレート
# ==============================================================================
# このファイルを `.env` にコピーして、各自のAPIキーを設定してください。
# ※ `.env` は .gitignore によりGit追跡から除外されているため、安全に保持されます。
# ※ Web画面（右上の設定アイコン）から直接キーを入力・保存することも可能です。

# 1. Google Gemini API キー (必須 - 完全無料・クレカ不要)
# 取得先: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Tavily Search API キー (任意 - 月1,000回無料)
# 取得先: https://app.tavily.com/
# ※ 未設定の場合は DuckDuckGo (完全無料・キー不要) が自動使用されます。
TAVILY_API_KEY=your_tavily_api_key_here

# 3. サーバー設定 (任意)
PORT=3939
GEMINI_MODEL=gemini-3.8-flash
SEARCH_PROVIDER=auto
