# ======================================================================
# Research Studio — 環境変数サンプル
# 本番デプロイ時（Render / Railway 等）またはローカル開発用
# ======================================================================

# サーバー待受ポート（デフォルト: 3939）
PORT=3939

# 実行環境（production / development）
NODE_ENV=production

# Google Gemini API キー（必須: 推論・要約・レポート生成）
# 取得先: https://aistudio.google.com/
GEMINI_API_KEY=

# Tavily API キー（商用Web検索エンジン: 高速かつ正確な情報収集）
# 取得先: https://tavily.com/
TAVILY_API_KEY=

# Groq API キー（バックアップ推論用・任意）
# 取得先: https://console.groq.com/
GROQ_API_KEY=

# Docker / Linux 環境での Chromium 実行パス（Dockerfile利用時は自動設定）
CHROME_PATH=/usr/bin/chromium

# ======================================================================
# クラウド認証・クォータ管理（Supabase連携時・任意）
# 設定しない場合はローカル無制限モードで自動動作します
# ======================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# クラウド管理者の利用者ID（カンマ区切りのUUID・B-1）
ADMIN_USER_IDS=

# 利用者ごとの履歴保存件数上限（既定: 100件・B-2）
HISTORY_MAX_PER_USER=100

# 利用者ごとの履歴保存日数（既定: 0 = 無期限・B-2）
HISTORY_RETENTION_DAYS=0

