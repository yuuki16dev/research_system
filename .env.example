# ======================================================================
# Research Studio — 環境変数サンプル
# 本番デプロイ時（Render / Railway 等）またはローカル開発用
# ======================================================================

# サーバー待受ポート（デフォルト: 3939）
PORT=3939

# 実行環境（production / development）
NODE_ENV=production

# Google Gemini API キー（必須: 推論・要約・レポート生成）
# 取得先: https://aistudio.google.com/
GEMINI_API_KEY=

# Tavily API キー（商用Web検索エンジン: 高速かつ正確な情報収集）
# 取得先: https://tavily.com/
TAVILY_API_KEY=

# Groq API キー（バックアップ推論用・任意）
# 取得先: https://console.groq.com/
GROQ_API_KEY=

# Docker / Linux 環境での Chromium 実行パス（Dockerfile利用時は自動設定）
CHROME_PATH=/usr/bin/chromium

# ======================================================================
# クラウド認証・クォータ管理（Supabase連携時・任意）
# 設定しない場合はローカル無制限モードで自動動作します
# ======================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# クラウド管理者の利用者ID（カンマ区切りのUUID・B-1）
ADMIN_USER_IDS=

# 利用者ごとの履歴保存件数上限（既定: 100件・B-2）
HISTORY_MAX_PER_USER=100

# 利用者ごとの履歴保存日数（既定: 0 = 無期限・B-2）
HISTORY_RETENTION_DAYS=0

# クラウド版でログイン不要モードを有効にする（既定は未設定＝ログイン必須）
# テスト公開時のみ ALLOW_ANONYMOUS_CLOUD=true を明示設定してください
# ALLOW_ANONYMOUS_CLOUD=true

# 全体の日次AI推定原価上限 (JPY、既定: 1000・R-5)
DAILY_COST_LIMIT_JPY=1000

# モデル単価の上書き JSON (USD per 1M tokens・R-6)
# AI Studio の請求画面で確認して設定してください
# MODEL_PRICING_JSON={"gemini-3.8-flash":{"inputPerMillion":0.075,"outputPerMillion":0.30}}

# Tavily 1クレジット単価 (USD、仮値: 0.008・R-6)
TAVILY_USD_PER_CREDIT=0.008

# 為替レート (JPY/USD、仮値: 150・R-6)
USD_JPY_RATE=150

# クラウド版でエラー時の切り替え先モデルを指定する場合のみ設定（未設定時は切り替えなし・R-6）
# GEMINI_FALLBACK_MODELS=

# リバースプロキシの信頼ホップ数（既定: 1・R-9）
TRUST_PROXY_HOPS=1


